{
  "name": "zotero-podcast",
  "type": "module",
  "version": "0.2.0",
  "description": "Create AI-generated podcasts from Zotero items and collections",
  "config": {
    "addonName": "Zotero Podcast",
    "addonID": "zotero-podcast@danieleongari.com",
    "addonRef": "zotero-podcast",
    "addonInstance": "PodcastAddon",
    "prefsPrefix": "extensions.zotero-podcast"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieleongari/zotero-podcast.git"
  },
  "author": "Daniele Ongari",
  "bugs": {
    "url": "https://github.com/danieleongari/zotero-podcast/issues"
  },
  "homepage": "https://github.com/danieleongari/zotero-podcast",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:zotero": "zotero-plugin test --no-watch"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "epubjs": "0.3.93"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@zotero-plugin/eslint-config": "0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
